{
  "name": "gym-tracker",
  "private": true,
  "version": "2.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @gym/api\" \"npm run dev -w @gym/web\"",
    "build": "npm run build -w @gym/web && npm run build -w @gym/api",
    "start": "npm run start -w @gym/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate -w @gym/api",
    "db:seed": "npm run seed -w @gym/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  }
}
