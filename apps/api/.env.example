# ---- Server ----
PORT=4000

# Local PostgreSQL (e.g. `docker compose up -d`):
DATABASE_URL=postgres://gym:gym@localhost:5432/gym_tracker
# Neon (or any hosted PostgreSQL): copy the connection string from the Neon dashboard (Connect button),
# paste it here instead of the line above, and make sure it ends with sslmode=verify-full:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Signs the login cookie. Use a long random string (32+ characters) in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The login cookie is HttpOnly + SameSite=Lax, and Secure when NODE_ENV=production.
# Only set this to false if you run production over plain HTTP (not recommended).
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy (nginx, Caddy, a host's load balancer).
# TRUST_PROXY=false
# Only needed if the web app is served from a DIFFERENT origin than the API. Leave empty otherwise.
# CORS_ORIGIN=

# ---- First-time setup (used by `npm run db:seed`) ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
OWNER_NAME=Gym Owner
GYM_NAME=My Gym
# Owner's mobile number (10 digits). Missed-payment alerts are sent here.
OWNER_PHONE=9876543210

# ---- Daily check ----
RUN_SCHEDULER=true
# Every day at 9:00 AM India time. Standard cron syntax.
CRON_SCHEDULE=0 9 * * *

# ---- Messaging ----
# true  = messages are only written to the Messages log, nothing is sent (safe for testing)
# false = messages are really sent through MSG91 and WhatsApp
MESSAGING_DRY_RUN=true

# MSG91 (SMS). Each template ID comes from your DLT-approved flow in MSG91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_REMINDER=
MSG91_TEMPLATE_MISSED_MEMBER=
MSG91_TEMPLATE_MISSED_OWNER=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANGUAGE=en
# Names of your approved WhatsApp templates (defaults shown)
WHATSAPP_TEMPLATE_REMINDER=gym_payment_reminder
WHATSAPP_TEMPLATE_MISSED_MEMBER=gym_payment_missed
WHATSAPP_TEMPLATE_MISSED_OWNER=gym_owner_missed_alert
